{
   "compilerOptions": {
      "target": "ES2022",
      "useDefineForClassFields": true,
      "lib": [
         "ES2024"
      ],
      "module": "ESNext",
      "skipLibCheck": true,
      "moduleResolution": "bundler",
      "allowImportingTsExtensions": true,
      "isolatedModules": true,
      "moduleDetection": "force",
      "emitDeclarationOnly": true,
      "declaration": true,
      "strict": true,
      "outDir": "../../dist-sdk",
      "types": [
         "node"
      ]
   }
}